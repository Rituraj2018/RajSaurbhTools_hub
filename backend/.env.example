# ═══════════════════════════════════════════════════════════
#  RajSaurbh Tool Hub Pro — Backend Environment Template
#  Copy this file to .env and fill in your values.
#  NEVER commit .env to version control.
# ═══════════════════════════════════════════════════════════

# ─── Server Configuration ──────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── MongoDB Atlas / Local Database URI ────────────────────
# Development default: mongodb://localhost:27017/rajsaurbh_tool_hub_pro
# Production Atlas: mongodb+srv://<username>:<password>@cluster.mongodb.net/rajsaurbh_tool_hub_pro?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/rajsaurbh_tool_hub_pro

# ─── JWT Authentication & Security ─────────────────────────
# REQUIRED in production — generate with: openssl rand -hex 64
JWT_SECRET=change_this_to_a_long_random_secret_in_production
JWT_EXPIRES_IN=7d

# ─── CORS Configuration ────────────────────────────────────
# Allowed origin for client requests (e.g., https://your-app.vercel.app in production)
CLIENT_URL=http://localhost:5173

# ─── Cloudinary Cloud Storage (Optional) ───────────────────
# If left empty, file uploads will automatically store locally in the /uploads directory
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── Google Drive Personal Cloud Storage (Optional) ────────
# Separate OAuth credentials for Google Drive file storage.
# If not set, falls back to GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET above.
# Create a Web Application OAuth client in Google Cloud Console
# with redirect URI: http://localhost:5000/api/cloud/google/callback
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REDIRECT_URI=http://localhost:5000/api/cloud/google/callback

# ─── Microsoft OneDrive Personal Cloud Storage (Optional) ──
# Register an application in Azure AD (Entra ID)
# with redirect URI: http://localhost:5000/api/cloud/microsoft/callback
# Grant delegated permission: Files.ReadWrite
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
MICROSOFT_REDIRECT_URI=http://localhost:5000/api/cloud/microsoft/callback
